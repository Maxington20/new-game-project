[gd_scene format=3 uid="uid://6e3628pr6ngm"]

[sub_resource type="GDScript" id="GDScript_a5oyu"]
script/source = "
extends Control


func _ready() -> void:
	var roster: CharacterRoster = load(
		\"res://resources/rosters/default_roster.tres\"
	)

	var catalogue: AchievementCatalogue = load(
		\"res://resources/achievements/achievement_catalogue.tres\"
	)

	var brienne: UnitResource = roster.get_character_by_id(\"brienne\")

	if brienne == null:
		push_error(\"Brienne not found\")
		return

	var progression := PermanentProgression.new()
	progression.add_achievement_progress(
		\"brienne\",
		\"enemies_defeated\",
		100
	)

	var state: RunUnitState = RunUnitState.create(brienne)
	state.character.level = 10

	var options: Array[UnitClassResource] = \\
		PromotionChoiceProvider.get_choices(
			state,
			progression,
			catalogue
		)

	var picker := PromotionSelection.new()
	add_child(picker)

	picker.promotion_selected.connect(_on_promotion_selected)
	picker.show_choices(\"Brienne\", options)

	print(\"Promotion screen opened: \", picker.visible)
	print(\"Available choices: \", options.size())


func _on_promotion_selected(promotion_class: UnitClassResource) -> void:
	print(\"Selected promotion: \", promotion_class.class_name_display)
"

[node name="TestScene" type="Control" unique_id=1123167761]
